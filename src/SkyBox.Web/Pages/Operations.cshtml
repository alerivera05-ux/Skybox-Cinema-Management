@page "/operacion"
@model OperationsModel
@{ ViewData["Title"] = "Operación"; }
<section class="section operations-page"><div class="section-heading"><div><p class="eyebrow">DETRÁS DE CADA GRAN FUNCIÓN</p><h1>Vista de operación<span class="accent">.</span></h1></div><span class="badge">DEMOSTRACIÓN LOCAL</span></div>
    <p class="muted">Controla la programación y la ocupación. Esta demo comparte una sola sesión de cine y no requiere cuenta de operador.</p>
    @if (Model.Notice is not null) { <div class="notice success" role="status">@Model.Notice</div> }
    <form method="get" class="filters"><label>Fecha del reporte<input type="date" name="Date" value="@Model.Date?.ToString("yyyy-MM-dd")" /></label><button class="button secondary" type="submit">Ver reporte</button></form>
    <div class="stats-grid"><article><span>Funciones</span><strong>@Model.Report.Screenings.ToString("00")</strong><small>en la fecha elegida</small></article><article><span>Asientos reservados</span><strong>@Model.Report.ReservedSeats <small>/ @Model.Report.Capacity</small></strong><small>@Model.Report.Occupancy.ToString("0.0")% de ocupación</small></article><article><span>Reservas activas</span><strong>@Model.Report.ActiveBookings.ToString("00")</strong><small>grupos confirmados</small></article><article><span>Importe reservado</span><strong><small>Bs</small> @Model.Report.ReservedValue.ToString("0.00")</strong><small>pendiente de pago en boletería</small></article></div>
    <div class="operations-layout"><div class="panel"><div class="panel-heading"><h2>Programación del día</h2><span class="muted">@Model.Date?.ToString("dd MMM yyyy")</span></div><div class="table-scroll"><table><caption class="sr-only">Funciones y ocupación de la fecha seleccionada</caption><thead><tr><th>Película / sala</th><th>Hora</th><th>Ocupación</th><th>Precio</th><th><span class="sr-only">Acción</span></th></tr></thead><tbody>
    @foreach (var screening in Model.Screenings)
    { <tr><td><strong>@screening.Movie.Title</strong><small>@screening.Room.Name · @screening.Format</small></td><td>@screening.StartsAt.ToString("HH:mm")</td><td><span>@screening.ReservedSeats / @screening.Room.Capacity</span><progress value="@screening.ReservedSeats" max="@screening.Room.Capacity" aria-label="Ocupación @screening.Room.Name"></progress></td><td>Bs @screening.Price.ToString("0.00")</td><td><a class="table-link" asp-page="/Seats" asp-route-id="@screening.Id" aria-label="Ver asientos para @screening.Movie.Title a las @screening.StartsAt.ToString("HH:mm")">Ver ↗</a></td></tr> }
    </tbody></table></div>@if (Model.Screenings.Count == 0) { <p class="empty-table">Todavía no hay funciones programadas para esta fecha.</p> }</div>
    <aside class="panel create-panel"><p class="eyebrow">AMPLÍA LA CARTELERA</p><h2>Nueva función</h2><div asp-validation-summary="All" class="validation" role="alert"></div><form method="post" class="stacked-form"><input type="hidden" name="Date" value="@Model.Date?.ToString("yyyy-MM-dd")" /><label>Película<select asp-for="Input.MovieId" required><option value="">Selecciona una película</option>@foreach (var movie in Model.Movies) { <option value="@movie.Id">@movie.Title · @movie.DurationMinutes min</option> }</select></label><label>Sala<select asp-for="Input.RoomId" required><option value="">Selecciona una sala</option>@foreach (var room in Model.Rooms) { <option value="@room.Id">@room.Name · @room.Capacity asientos</option> }</select></label><label>Fecha y hora (Bolivia)<input asp-for="Input.StartsAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" required /></label><div class="form-pair"><label>Precio (Bs)<input asp-for="Input.Price" type="number" min="1" max="500" step="0.01" required /></label><label>Formato<select asp-for="Input.Format"><option>2D DOB</option><option>2D SUB</option><option>Ultra Láser DOB</option></select></label></div><p class="fine-print">Se comprueba la duración y un margen de limpieza de 15 minutos. Puedes programar hasta 90 días por adelantado.</p><button class="button full" type="submit">Agregar función <span aria-hidden="true">+</span></button></form></aside></div>
</section>
