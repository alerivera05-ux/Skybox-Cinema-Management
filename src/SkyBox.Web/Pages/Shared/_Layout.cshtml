@{
    var current = ViewContext.RouteData.Values["page"]?.ToString();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101112" />
    <meta name="description" content="Sky Box Cinema. Explora la cartelera, elige tu asiento y vive el cine." />
    <title>@ViewData["Title"] · Sky Box Cinema</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
        <a class="brand" asp-page="/Index" aria-label="Sky Box Cinema, inicio"><span class="brand-mark">S<span>↗</span></span><span>SKY BOX<small>CINEMA</small></span></a>
        <nav aria-label="Navegación principal">
            <a asp-page="/Index" class="@(current is "/Index" or "/Seats" ? "active" : "")" aria-current="@(current == "/Index" ? "page" : null)">Cartelera</a>
            <a asp-page="/Reservations" class="@(current is "/Reservations" or "/Ticket" ? "active" : "")">Mi reserva</a>
            <a asp-page="/Operations" class="@(current == "/Operations" ? "active" : "")">Operación</a>
        </nav>
        <span class="location"><span class="status-dot"></span> Bolivia <span class="muted">/ Bs</span></span>
    </header>
    <main id="contenido">@RenderBody()</main>
    <footer class="site-footer">
        <a class="footer-brand" asp-page="/Index">SKY BOX <span>CINEMA</span></a>
        <p>La pantalla es solo el comienzo.</p>
        <span>Edición demo · Las reservas se reinician al cerrar el servidor.</span>
    </footer>
</body>
</html>
